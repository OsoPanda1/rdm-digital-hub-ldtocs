##############################################################################
# RDM Digital Hub — Variables de Entorno (Producción)
# Copia a .env y rellena los valores antes de desplegar
##############################################################################

# ─── DOMINIO ──────────────────────────────────────────────────────────────
SITE_HOST=visitarealdelmonte.online
API_HOST=api.visitarealdelmonte.online
DASHBOARD_HOST=traefik.visitarealdelmonte.online

# ─── LET'S ENCRYPT ────────────────────────────────────────────────────────
ACME_EMAIL=tamvonlinenetwork@outlook.es

# ─── TRAEFIK DASHBOARD AUTH ────────────────────────────────────────────────
# Genera con: htpasswd -nB admin
# IMPORTANTE: Escapa $ como $$ en docker-compose
DASHBOARD_AUTH=admin:$$2y$$10$$YOUR_BCRYPT_HASH_HERE

# ─── BASE DE DATOS ────────────────────────────────────────────────────────
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ─── JWT / AUTH ────────────────────────────────────────────────────────────
SUPABASE_JWT_SECRET=CHANGE_ME_TO_YOUR_JWT_SECRET

# ─── OPENAI (opcional) ────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── BACKBLAZE B2 ─────────────────────────────────────────────────────────
BACKUP_BUCKET=rdm-digital-hub-backups
BACKUP_KEY=YOUR_B2_KEY_ID
BACKUP_SECRET=YOUR_B2_APPLICATION_KEY
BACKUP_RETENTION_DAYS=30
