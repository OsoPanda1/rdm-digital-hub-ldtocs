{
  "name": "rdm-nodo-cero-digital-hub",
  "version": "1.5.0",
  "private": true,
  "description": "Nodo Cero de Real del Monte: turismo, historia, cultura, gastronomía, AI, gamificación 2D/3D, mapas, pagos, digital twins y sistemas federados con arquitectura antifrágil.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0 <25",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "cd apps/rdm-hub && ./node_modules/.bin/next dev",
    "dev:hub": "turbo run dev --filter apps/rdm-hub",
    "dev:visitarealdelmonte": "turbo run dev --filter apps/visitarealdelmonte-core",
    "dev:mobile": "turbo run dev --filter apps/5-tenedores",
    "dev:ai": "turbo run dev --filter domains/ai",
    "dev:gamification": "turbo run dev --filter apps/gamification-3d",
    "dev:observability": "turbo run dev --filter apps/observability",
    "build": "turbo run build",
    "build:dev": "cd apps/rdm-hub && ./node_modules/.bin/next build",
    "build:hub": "turbo run build --filter apps/rdm-hub",
    "build:visitarealdelmonte": "turbo run build --filter apps/visitarealdelmonte-core",
    "build:mobile": "turbo run build --filter apps/5-tenedores",
    "build:ai": "turbo run build --filter domains/ai",
    "build:gamification": "turbo run build --filter apps/gamification-3d",
    "node:turismo": "turbo run build --filter rdm-hub",
    "node:cultura": "turbo run build --filter rdm-hub",
    "node:gastronomia": "turbo run build --filter rdm-hub",
    "node:ai": "turbo run build --filter rdm-hub",
    "node:gamificacion": "echo \"[node:gamificacion] apps/gamification-3d no existe aun\"",
    "node:mapas": "echo \"[node:mapas] domains/maps es scaffold, sin build aun\"",
    "node:seguridad": "echo \"[node:seguridad] domains/security es scaffold, sin build aun\"",
    "lazy:secondary": "node scripts/lazy-secondary.mjs",
    "lazy:tertiary": "node scripts/lazy-tertiary.mjs",
    "lint": "turbo run lint",
    "lint:strict": "turbo run lint --parallel --filter \"apps/*\" --filter \"domains/*\" --filter \"packages/*\"",
    "typecheck": "turbo run typecheck --filter \"apps/*\" --filter \"domains/*\" --filter \"packages/*\"",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit --filter apps/visitarealdelmonte-core",
    "test:e2e": "turbo run test:e2e --filter apps/visitarealdelmonte-core",
    "test:ai": "turbo run test --filter domains/ai",
    "test:security": "turbo run test --filter domains/security",
    "coverage": "turbo run coverage --filter apps/visitarealdelmonte-core",
    "security:scan": "turbo run security:scan",
    "security:audit": "turbo run audit --filter apps/visitarealdelmonte-core",
    "security:dependencies": "turbo run deps --filter apps/visitarealdelmonte-core",
    "security:hardening": "turbo run hardening --filter infra/security",
    "governance:policy-check": "turbo run policy:check --filter domains/governance",
    "db:migrate": "powershell -ExecutionPolicy Bypass -File scripts/apply-migrations.ps1",
    "db:seed": "powershell -ExecutionPolicy Bypass -File scripts/apply-seed.ps1",
    "db:check": "turbo run db:check --filter infra/databases",
    "backup": "turbo run backup",
    "backup:run": "turbo run backup --filter infra/backups",
    "backup:verify": "turbo run backup:verify --filter infra/backups",
    "backup:restore": "turbo run backup:restore --filter infra/backups",
    "backup:drill": "turbo run backup:drill --filter infra/backups",
    "observability:dev": "turbo run dev --filter apps/observability",
    "observability:check": "turbo run check --filter domains/observability",
    "observability:trace": "turbo run trace --filter domains/observability",
    "latency:profiles": "turbo run latency:profiles --filter domains/observability",
    "maps:build": "turbo run build --filter domains/maps",
    "digitaltwins:sync": "turbo run sync --filter domains/digital-twins",
    "ai:perception-flow": "turbo run check --filter domains/ai",
    "ai:voice-isabella": "turbo run build --filter domains/ai-voice",
    "payments:build": "turbo run build --filter domains/payments",
    "payments:test": "turbo run test --filter domains/payments",
    "format": "turbo run format",
    "clean": "turbo run clean && pnpm -r exec rimraf node_modules .turbo .next dist",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "ci": "pnpm check && pnpm build",
    "ci:full": "turbo run ci --filter \"apps/*\" --filter \"domains/*\" --filter \"packages/*\" --filter \"infra/*\""
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "domains/*",
    "infra/*"
  ],
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.8.3",
    "@types/node": "^22.20.1",
    "pnpm": "^10.0.0",
    "eslint": "^9.39.5",
    "@eslint/js": "^9.32.0",
    "prettier": "^3.7.3",
    "rimraf": "^5.0.0"
  }
}
