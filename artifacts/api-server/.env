# RDM Digital Hub — API Server Environment Variables

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@helium/heliumdb?sslmode=disable

# ── Security (REQUIRED — no hardcoded fallbacks) ─────────────
MEXA_API_SECURE_KEY=dev-key-change-in-production
YUN_SIGNING_SECRET=dev-secret-change-in-production

# ── Supabase Auth (JWT verification) ────────────────────────
# Get from: Supabase Dashboard > Settings > API > JWT Secret
SUPABASE_JWT_SECRET=

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Server ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
