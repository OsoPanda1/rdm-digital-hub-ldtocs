# RDM Digital Hub — API Server Environment Variables
# Copy this to .env and fill in the values

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@helium/heliumdb?sslmode=disable

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Security (REQUIRED — no hardcoded fallbacks) ─────────────
# MEXA_API_SECURE_KEY: Used for federation mask signing (Mexa API).
# YUN_SIGNING_SECRET: Used for YUN message bus event signing.
# Both MUST be set — the server will refuse to start without them.
MEXA_API_SECURE_KEY=your-mexa-api-secure-key
YUN_SIGNING_SECRET=your-yun-bus-signing-secret

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins (production).
ALLOWED_ORIGINS=http://localhost:5173,https://your-replit-url.replit.dev

# ── Server ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# ── Federation ───────────────────────────────────────────────
RDM_SECURITY_PROFILE=dev-relaxed
RDM_FEDERATION_MODE=heptafederado-dev
RDM_OBSERVABILITY_MODE=verbose
