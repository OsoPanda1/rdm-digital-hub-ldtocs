modules = ["nodejs-20", "python-3.12", "web"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/rdm-hub: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/api-server: RDM API Gateway"

[[workflows.workflow]]
name = "artifacts/rdm-hub: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=22942 BASE_PATH=/ pnpm --filter @workspace/rdm-hub run dev"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
# ⚠️  All secrets below MUST be set via Replit Secrets panel, NOT hardcoded here.
# The values shown are development placeholders only. Never commit real credentials.
DATABASE_SUPABASE_ANON_KEY = ""
DATABASE_SUPABASE_PUBLISHABLE_KEY = ""
DATABASE_SUPABASE_URL = ""
DATABASE_POSTGRES_DATABASE = ""
DATABASE_POSTGRES_HOST = ""
DATABASE_POSTGRES_PASSWORD = ""
VITE_SUPABASE_URL = ""
VITE_SUPABASE_ANON_KEY = ""
SUPABASE_URL = ""
SUPABASE_ANON_KEY = ""
VITE_API_URL = "/api/v1"
VITE_API_BASE_URL = "/api/v1"
VITE_API_GATEWAY = "/api"
VITE_SITE_URL = "https://visitarealdelmonte.online"
ALLOWED_ORIGINS = "https://visitarealdelmonte.online,https://www.visitarealdelmonte.online"

[objectStorage]
defaultBucketID = "replit-objstore-ada06ee1-bbce-4cd4-8773-f20ba74147c6"
